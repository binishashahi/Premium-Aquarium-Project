<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aquarium World</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto&display=swap" rel="stylesheet">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Roboto', sans-serif; background: #e0f7fa; color: #333; overflow-x: hidden; }

        /* Animated water gradient background */
        body::before {
            content: "";
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: linear-gradient(135deg, #00bcd4, #0077b6, #00acc1);
            z-index: -2;
            animation: gradientMove 15s ease infinite;
        }
        @keyframes gradientMove {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        /* Fish bubbles */
        .bubble {
            position: absolute;
            border-radius: 50%;
            opacity: 0.7;
            animation: floatUp linear infinite;
            background: rgba(255,255,255,0.4);
        }
        @keyframes floatUp {
            0% { transform: translateY(100vh); opacity: 0; }
            50% { opacity: 0.7; }
            100% { transform: translateY(-10vh); opacity: 0; }
        }

        header {
            background: rgba(0,119,182,0.8);
            color: white;
            padding: 25px 20px;
            text-align: center;
            box-shadow: 0 4px 8px rgba(0,0,0,0.2);
        }
        header h1 { margin-bottom: 5px; font-size: 2rem; }
        header p { font-size: 1rem; }

        .container {
            width: 90%;
            max-width: 1200px;
            margin: 30px auto;
        }

        .section-wrapper {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
        }

        .section {
            flex: 1 1 400px;
            background: rgba(255,255,255,0.95);
            padding: 25px;
            border-radius: 20px;
            box-shadow: 0 8px 20px rgba(0,0,0,0.2);
            transition: transform 0.3s, box-shadow 0.3s;
        }
        .section:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 25px rgba(0,0,0,0.3);
        }

        form input, form textarea, form button {
            width: 100%;
            padding: 12px;
            margin-bottom: 15px;
            border-radius: 12px;
            border: 1px solid #ccc;
            font-size: 1rem;
        }
        form textarea { resize: none; }
        form button {
            background: #0077b6;
            color: white;
            border: none;
            cursor: pointer;
            transition: background 0.3s;
        }
        form button:hover { background: #005f86; }

        .map-container iframe {
            width: 100%;
            height: 400px;
            border: none;
            border-radius: 15px;
        }

        footer {
            background: rgba(0,119,182,0.8);
            color: white;
            padding: 15px;
            text-align: center;
            margin-top: 40px;
            box-shadow: 0 -4px 8px rgba(0,0,0,0.2);
        }

        @media(max-width: 768px){
            .section-wrapper { flex-direction: column; }
        }
    </style>
</head>
<body>

    <!-- Floating Bubbles -->
    <div class="bubble" style="width:20px; height:20px; left:10%; animation-duration:8s;"></div>
    <div class="bubble" style="width:15px; height:15px; left:30%; animation-duration:10s;"></div>
    <div class="bubble" style="width:25px; height:25px; left:50%; animation-duration:12s;"></div>
    <div class="bubble" style="width:18px; height:18px; left:70%; animation-duration:9s;"></div>
    <div class="bubble" style="width:22px; height:22px; left:85%; animation-duration:11s;"></div>

    <header>
        <h1>Aquarium World</h1>
        <p>Create your own underwater paradise</p>
    </header>

    <div class="container">
        <div class="section-wrapper">

            <!-- Contact Form -->
            <div class="section">
                <h2>Contact Us</h2>
                <form>
                    <input type="text" placeholder="First Name" required>
                    <input type="text" placeholder="Last Name" required>
                    <input type="email" placeholder="Email Address" required>
                    <input type="text" placeholder="Subject" required>
                    <textarea rows="5" placeholder="How Can We Help?" required></textarea>
                    <button type="submit">Submit</button>
                </form>
            </div>

            <!-- Google Map -->
            <div class="section map-container">
                <h2>Visit Our Store</h2>
                <iframe 
                    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2381.243158540872!2d-2.2743131841765747!3d53.48960007998386!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x487bb1d6e27e86f3%3A0x6e52ad72b45a7e0!2s26%20Cobden%20St%2C%20Salford%20M6%206WF%2C%20UK!5e0!3m2!1sen!2snp!4v1697634696036!5m2!1sen!2snp" 
                    allowfullscreen="" 
                    loading="lazy" 
                    referrerpolicy="no-referrer-when-downgrade">
                </iframe>
            </div>

        </div>
    </div>

    <footer>
        &copy; 2026 Aquarium World | All Rights Reserved
    </footer>

</body>
</html>